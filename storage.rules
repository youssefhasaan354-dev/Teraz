rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isStaff() {
      return request.auth != null;
    }

    // Public read for brand and media assets
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff()
                   && request.resource.size < 15 * 1024 * 1024 // 15MB limit
                   && request.resource.contentType.matches('image/.*|video/.*|application/pdf');
    }

    // Public lead upload attachments (e.g. floorplans, kitchen sketches)
    match /attachments/{leadId}/{fileName} {
      allow create: if request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|application/pdf');
      allow read, delete: if isStaff();
    }
  }
}
