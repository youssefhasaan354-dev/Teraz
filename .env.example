# ===================================================
# TERAZ (طراز) — Environment Variables Template
# ===================================================
# Copy this file to .env.local and populate with your real values.
# NEVER commit .env.local to Git.

# Public Site URL (Used for sitemaps, canonical tags & OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Client Configuration (Cloud Firestore, Auth, Storage)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin Private Key (for secure server-side verification)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ISR On-Demand Revalidation Secret
REVALIDATION_SECRET=

# Email / Notification Service (Resend or Nodemailer)
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=terazfurneture@gmail.com
